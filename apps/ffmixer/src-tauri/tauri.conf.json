{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ffmixer",
  "version": "0.1.2",
  "identifier": "dev.ffmixer.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ffmixer — Fireface 800",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "category": "Music",
    "shortDescription": "TotalMix FX-style mixer for the RME Fireface 800",
    "longDescription": "A mixer and settings app for RME Fireface interfaces on Linux. It controls the unit through FFADO. Not affiliated with RME.",
    "copyright": "ffmixer contributors",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../../../LICENSE",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0"
        ],
        "recommends": [
          "ffado-dbus-server"
        ]
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3"
        ],
        "recommends": [
          "ffado"
        ]
      }
    }
  }
}
